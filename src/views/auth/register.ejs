<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --gold: #d4af37;
            --gold-light: #f6e3a1;
            --black: #101010;
            --panel: #191919;
        }

        body {
            background: var(--black);
            color: #f5f5f5;
            min-height: 100vh;
        }

        .auth-shell {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        .auth-art {
            background:
                linear-gradient(135deg, rgba(0, 0, 0, .75), rgba(12, 12, 12, .4)),
                url("https://images.unsplash.com/photo-1455390582262-044cdead277a?auto=format&fit=crop&w=1200&q=85") center/cover;
            display: flex;
            flex-direction: column;
            justify-content: end;
            padding: 60px;
        }

        .auth-art h1 {
            color: var(--gold-light);
            font-size: clamp(2.5rem, 4vw, 4rem);
            font-weight: 800;
        }

        .auth-form-wrap {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 32px;
        }

        .auth-card {
            width: 100%;
            max-width: 470px;
            background: var(--panel);
            padding: 36px;
            border: 1px solid #3a3020;
            border-radius: 20px;
            box-shadow: 0 20px 60px #0008;
        }

        .gold-text {
            color: var(--gold);
        }

        .form-control,
        .form-select {
            background: #101010;
            color: #fff;
            border: 1px solid #49402d;
            padding: 12px;
        }

        .form-control:focus,
        .form-select:focus {
            background: #101010;
            color: #fff;
            border-color: var(--gold);
            box-shadow: 0 0 0 .2rem #d4af3722;
        }

        .form-select option {
            background: #191919;
        }

        .btn-gold {
            background: var(--gold);
            color: #111;
            border: 0;
            font-weight: 700;
            padding: 12px;
        }

        .btn-gold:hover {
            background: var(--gold-light);
            color: #111;
        }

        .form-label {
            color: #e6dfd0;
        }

        .auth-link {
            color: var(--gold-light);
        }

        .alert-success {
            background: #193323;
            color: #b9f5c8;
            border-color: #315d3e;
        }

        .alert-danger {
            background: #381b1b;
            color: #ffcccc;
            border-color: #6c3333;
        }

        @media (max-width: 800px) {
            .auth-shell {
                grid-template-columns: 1fr;
            }

            .auth-art {
                display: none;
            }

            .auth-form-wrap {
                padding: 20px;
            }

            .auth-card {
                padding: 26px 20px;
            }
        }
    </style>
</head>

<body>
    <main class="auth-shell">
        <section class="auth-art">
            <h1>Every voice has a story.</h1>
            <p class="fs-5">
                Read inspiring ideas or apply to become a writer in our community.
            </p>
        </section>

        <section class="auth-form-wrap">
            <div class="auth-card">
                <a href="/" class="auth-link text-decoration-none">← Back to home</a>

                <h2 class="mt-4 fw-bold">Create your account</h2>
                <p class="text-secondary">
                    Join the community. Choose how you want to participate.
                </p>

                <% if (error) { %>
                    <div class="alert alert-danger">
                        <%= error %>
                    </div>
                    <% } %>

                        <% if (success) { %>
                            <div class="alert alert-success">
                                <%= success %>
                            </div>
                            <% } %>

                                <% if (!success) { %>
                                    <form action="/ejs/register" method="POST">
                                        <div class="mb-3">
                                            <label class="form-label" for="name">Full name</label>
                                            <input class="form-control" id="name" name="name" minlength="2"
                                                maxlength="50" autocomplete="name" required>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label" for="email">Email address</label>
                                            <input class="form-control" id="email" name="email" type="email"
                                                autocomplete="email" required>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label" for="password">Password</label>
                                            <input class="form-control" id="password" name="password" type="password"
                                                minlength="8" autocomplete="new-password" required>
                                            <small class="text-secondary">
                                                Use at least 8 characters.
                                            </small>
                                        </div>

                                        <div class="mb-4">
                                            <label class="form-label" for="role">Register as</label>
                                            <select class="form-select" id="role" name="role" required>
                                                <option value="user">User — read published blogs</option>
                                                <option value="writer">Writer — submit an application</option>
                                            </select>
                                            <small class="text-secondary d-block mt-2">
                                                Writer access remains locked until approved by an admin.
                                            </small>
                                        </div>

                                        <button class="btn btn-gold w-100" type="submit">
                                            Create account
                                        </button>
                                    </form>
                                    <% } %>

                                        <p class="text-center mt-4 mb-0">
                                            Already have an account?
                                            <a href="/ejs/login" class="auth-link">Log in</a>
                                        </p>
            </div>
        </section>
    </main>
</body>

</html>